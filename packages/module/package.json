{
  "name": "sinter-js",
  "version": "0.2.2",
  "description": "High-performance browser image compression library with fluent API — supports JPEG, PNG, WebP, AVIF, and BMP via WASM codecs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/semanticist21/sinter.git",
    "directory": "packages/module"
  },
  "keywords": [
    "image",
    "compression",
    "webp",
    "avif",
    "jpeg",
    "png",
    "bmp",
    "wasm",
    "browser",
    "resize"
  ],
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:native && tsdown && bun run build:native:copy-dist",
    "build:native": "bun scripts/build-jpeg-wasm.ts && bun scripts/build-avif-wasm.ts",
    "build:native:copy-dist": "bun scripts/build-jpeg-wasm.ts --copy-dist && bun scripts/build-avif-wasm.ts --copy-dist",
    "check": "tsgo -p tsconfig.json --noEmit",
    "test": "bun run build:native && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/upng-js": "^2.1.5",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "upng-js": "^2.1.0"
  }
}
