{
  "name": "sinter-monorepo",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "check": "biome check . && bun --filter '*' check",
    "demo": "bun --filter @sinter/module build && bun --filter @sinter/demo dev",
    "dev": "bun --filter @sinter/demo dev",
    "fix": "biome check . --write",
    "update": "bun update"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10"
  }
}
