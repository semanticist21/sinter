{
  "name": "sinter-monorepo",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "check": "biome check . && bun --filter '*' check",
    "demo": "bun --filter sinter-js build && bun --filter @sinter/demo dev",
    "dev": "bun --filter @sinter/demo dev",
    "publish:module": "npm whoami && bun --filter sinter-js build && cp README.md packages/module/README.md && cd packages/module && npm publish",
    "fix": "biome check . --write",
    "update": "bun update"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/upng-js": "^2.1.5",
    "@typescript/native-preview": "^7.0.0-dev.20260414.1"
  },
  "dependencies": {
    "upng-js": "^2.1.0"
  }
}
