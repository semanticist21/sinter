{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noImplicitBoolean": "warn",
        "useBlockStatements": "warn",
        "useConst": "warn",
        "useExponentiationOperator": "warn",
        "useSelfClosingElements": "warn",
        "useTemplate": "warn"
      },
      "suspicious": {
        "noDoubleEquals": "warn",
        "noExplicitAny": "error",
        "noImplicitAnyLet": "warn",
        "noPrototypeBuiltins": "warn"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noConstAssign": "error",
        "noUndeclaredVariables": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "bracketSameLine": false
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "json": {
    "parser": {
      "allowTrailingCommas": false
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "package.json",
      "biome.json",
      "tsconfig.base.json",
      "packages/**/package.json",
      "packages/**/tsconfig.json",
      "packages/**/index.html",
      "packages/**/*.config.js",
      "packages/**/*.config.mjs",
      "packages/**/*.config.ts",
      "packages/**/src/**/*.js",
      "packages/**/src/**/*.mjs",
      "packages/**/src/**/*.ts",
      "packages/**/src/**/*.tsx",
      "packages/**/src/**/*.css",
      "packages/**/test/**/*.ts"
    ]
  }
}
